<.layout
  current_page={~p"/organize/#{@competition.id}/jury_launcher"}
  current_user={@current_user}
>
  <.competition_header competition={@competition} />
  <.steps_header current_step={:jury} competition={@competition} />
  <div id="jury-launcher-content" class="mt-20 px-4">
    <div
      id="jury-categories-stats"
      class="mx-auto grid max-w-7xl grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
    >
      <%= if !@competition.for_teams do %>
        <%= for {camera_type, stats} <- @stats.camera_type do %>
          <.jury_stat_card
            name={stats.name}
            slides_count={stats.slides_count}
            species_count={stats.species_count}
            href={"/organize/#{@competition_id}/jury?category=#{camera_type}"}
          />
        <% end %>
        <%= for {category, stats} <- @stats.category do %>
          <.jury_stat_card
            name={stats.name}
            slides_count={stats.slides_count}
            species_count={stats.species_count}
            href={"/organize/#{@competition_id}/jury?category=#{category}"}
          />
        <% end %>
      <% end %>
      <.jury_stat_card
        id="jury-all-stats"
        button_id="start-jury-btn"
        name={@stats.all.name}
        slides_count={@stats.all.slides_count}
        species_count={@stats.all.species_count}
        href={"/organize/#{@competition_id}/jury"}
        highlighted={true}
      />
    </div>
  </div>
  <div class="flex flex-col gap-3 px-4 my-10 w-full sm:flex-row sm:items-center sm:gap-2">
    <.link
      navigate={"/organize/#{@competition_id}/validation_launcher"}
      class="btn gap-2 w-full sm:w-auto sm:min-w-40 h-12 justify-center items-center"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      {gettext("Validation")}
    </.link>
    <div class="hidden grow sm:block" />
    <.link
      :if={!@competition.for_teams}
      navigate={"/organize/#{@competition_id}/results"}
      class="btn btn-primary gap-2 w-full sm:w-auto sm:min-w-40 h-12 justify-center items-center"
    >
      {gettext("Results")}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </.link>
    <.link
      :if={@competition.for_teams}
      navigate={"/organize/#{@competition_id}/team_results"}
      class="btn btn-primary gap-2 w-full sm:w-auto sm:min-w-40 h-12 justify-center items-center"
    >
      {gettext("Results")}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </.link>
  </div>
</.layout>
